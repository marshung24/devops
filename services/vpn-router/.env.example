# 複製為 .env 後填入（本機管多台主機時用 .env.<主機名>，選檔順序見 tools/install.sh 用法，主機上一律存成 .env）；含密鑰，不進版控

# 允許部署的 ssh 主機名（空白分隔，含別名），不是 profile；profile 指設定檔檔名 .env.{profile}，兩者通常相同但不一定
# tools/install.sh 上傳前比對，未列出即中止；留空時補填首次部署的主機
INSTALL_HOSTS=

# ── 共用 ──
# 轉送主機的 LAN IP：DHCP 分流路由的下一跳，也是 routing peer 連控制面的位址
HOST_LAN_IP=192.168.1.21

# ── DHCP ──
DHCP_INTERFACE=enp2s0
# 位址池須在 LAN 網段內，且不可涵蓋閘道與固定 IP 的主機
DHCP_POOL_START=192.168.1.100
DHCP_POOL_END=192.168.1.199
DHCP_LEASE_TIME=12h
DHCP_GATEWAY=192.168.1.1
DHCP_DNS=8.8.8.8,168.95.1.1
# 目標網段：DHCP 把它指向轉送主機
DHCP_ROUTE_NET=10.10.0.0/16

# ── NetBird ──
# 須在共用反向代理對外根網域下一層；只用單一網域（OIDC issuer 只能一個）
NB_DOMAIN=netbird.wan.example.com
# 須與共用反向代理的對外 port 相同（主機 443 被佔用時改用其他 port，例：8443）
NB_PUBLIC_PORT=443
NB_PEER_HOSTNAME=minipc-01
# 自架 Dashboard → Setup Keys 建立的一次性 key（控制面起來後才有，先留空）
NB_SETUP_KEY=
# 控制面密鑰：NB_AUTH_SECRET 用 `openssl rand -base64 32 | tr -d '='`；
#             其餘兩個用 `openssl rand -base64 32`（完整保留輸出）
NB_AUTH_SECRET=
NB_SESSION_COOKIE_KEY=
NB_STORE_ENCRYPTION_KEY=

# ── 使用者說明頁 ──
# 須在共用反向代理的 LAN 根網域下一層（只限內部來源，掛對外網域無用）
VPN_GUIDE_DOMAIN=vpn.lan.example.com
# 換 LAN 網域並行期的舊說明頁網域（選用），並行結束清空
VPN_GUIDE_LEGACY_DOMAIN=
# 允許開啟說明頁的來源網段，逗號分隔：LAN、NetBird（100.64.0.0/10）及其他內部來源
# 主機上另有前置代理（如 nginx 443）轉入 Traefik 時，來源為 traefik-proxy 閘道，須加 172.30.0.1/32
VPN_GUIDE_ALLOW=192.168.1.0/24,100.64.0.0/10
